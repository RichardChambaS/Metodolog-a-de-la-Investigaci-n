@ARTICLE{Roca2022,
	author = {Roca, Surya and Rosset, Sophie and García, José and Alesanco, Álvaro},
	title = {A Study on the Impacts of Slot Types and Training Data on Joint Natural Language Understanding in a Spanish Medication Management Assistant Scenario},
