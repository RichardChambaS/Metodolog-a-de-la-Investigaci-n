	title = {Disha: A Bilingual Humanoid Virtual Assistant},
	year = {2024},
	journal = {Proceedings - 6th International Conference on Electrical Engineering and Information and Communication Technology, ICEEICT 2024},
	pages = {457 - 462},
	doi = {10.1109/ICEEICT62016.2024.10534321},
	url = {https://www.scopus.com/pages/publications/85195239890?origin=resultslist},
	abstract = {Researchers and tech giants have developed AI-based virtual assistants that can answer basic questions, largely in English. As People are consumed by smart devices in modern life, a virtual assistant can be a game-changer. Surprisingly, no work has been done to adapt AI-based virtual assistants for the Bengali language. In this paper, we introduce a humanoid virtual assistant named 'Disha' designed to cater primarily to the banking sector in Bangladesh. Disha is capable of answering customers' financial service-related questions and conducting real-time transactions. Initially, we developed a web-chat system using RASA and trained models for automatic speech recognition (ASR) and text-to-speech (TTS) that operate in both Bengali and English separately. This project not only serves the current banking needs but also contributes to future research, potentially reducing the reliance on human agents and replacing traditional IVR and chatbots in the banking sector. © 2024 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@BOOK{Priya2025171,
	author = {Priya, S. Baghavathi and Rajamanogaran, M. and Subha, S. and Madeswaran, Tamilselvi},
	title = {BHELS: Bot for Higher Education Learning System},
	year = {2025},
	journal = {Adopting Artificial Intelligence Tools in Higher Education: Teaching and Learning},
	pages = {171 - 186},
	doi = {10.1201/9781003469315-8},
	url = {https://www.scopus.com/pages/publications/85215245712?origin=resultslist},
	abstract = {Chatbots are user-defined applications that are integrated with a popular conversational interface that satisfies the current demand of learners in higher education. The chatbot comprises three components, namely natural language processing framework, dialog manager (DM), and backend. Natural language generation emphasizes generating responses that resemble human language by utilizing a data-driven methodology. Natural language understanding is dedicated to extracting meaning from unstructured human language input, focused on the learner’s objective through categorizing their intention and extracting relevant details. The proposed system is to design a Bot for Higher Education Learning System (BHELS). BHELS provides personalized guidance throughout the higher education journey. The BHELS represents an overview of a higher education learning system that utilizes various steps to enhance learner interactions and provide desired responses. The learner selects an option from the suggestions and the selected option is fed as input into the long short-term memory (LSTM) model for response prediction. The LSTM model predicts a response relevant to the input query, enhancing the model’s ability to obtain an accuracy rate of 98.3% of customized responses. By following these steps, the higher education system streamlines learners’ interactions and provides tailored responses, thereby enhancing the learning experience. © 2025 selection and editorial matter, Thangavel Murugan, Karthikeyan Periasamy, and A.M. Abirami; individual chapters, the contributors.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Agarwal2024195,
	author = {Agarwal, S. and Jain, M.},
	title = {A comparative study of different BERT modifications},
	year = {2024},
	journal = {Artificial Intelligence, Blockchain, Computing and Security - Proceedings of the International Conference on Artificial Intelligence, Blockchain, Computing and Security, ICABCS 2023},
