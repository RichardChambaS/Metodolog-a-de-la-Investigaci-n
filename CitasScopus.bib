@CONFERENCE{Patel20211889,
	author = {Patel, Raj Nath and Burgin, Edward and Assem, Haytham and Dutta, Sourav},
	title = {Efficient Multi-Lingual Sentence Classification Framework with Sentence Meta Encoders},
	year = {2021},
	journal = {Proceedings - 2021 IEEE International Conference on Big Data, Big Data 2021},
