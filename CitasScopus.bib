	title = {The Role of AI in Patients' Communication},
	year = {2024},
	journal = {2024 2nd DMIHER International Conference on Artificial Intelligence in Healthcare, Education and Industry, IDICAIEI 2024},
	pages = {},
	doi = {10.1109/IDICAIEI61867.2024.10842915},
	url = {https://www.scopus.com/pages/publications/85217872992?origin=resultslist},
	abstract = {Artificial intelligence plays a transformative role in healthcare patient communication. AI technologies enable patients to interact with healthcare providers in a seamless and personalized manner through NLP functionalities such as machine learning and natural language understanding. These AI-driven chatbots and virtual assistants facilitate real-time, convenient access to healthcare information, schedule appointments, and triage symptoms. These systems will be able to interpret questions from the patients and provide appropriate responses that are not only correct but also empathetic, raising levels of satisfaction and engagement. Furthermore, AI shapes the landscape of multilingual communication, eradicating language barriers to healthcare access for patients of various backgrounds. More advanced AI in the future can adapt to the patient's needs and preferences with increased emotional intelligence and adaptive capabilities to ensure personalized interactions. The role of AI in patient communication continues to expand, working towards improved delivery of healthcare and patient outcomes through better access, responsiveness, and personalization of care.  © 2024 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
