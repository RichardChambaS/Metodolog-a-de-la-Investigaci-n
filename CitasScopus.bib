	title = {Deep Reinforcement Learning for Adaptive AI Chatbots in Customer Service and Personalized Virtual Assistance Systems},
	year = {2025},
	journal = {ICCR 2025 - 3rd International Conference on Cyber Resilience},
	pages = {},
	doi = {10.1109/ICCR67387.2025.11292000},
	url = {https://www.scopus.com/pages/publications/105031573198?origin=resultslist},
	abstract = {Conversational agents powered by AI provide dynamic and personalized user experiences. Digital communication is increasingly vital for customer engagement. However, static chat systems generally ignore real-time user interactions. Rules- or supervised-learning-based chatbots cannot adapt to changing user intentions, maintain context consistency during long discussions, or provide user-specific replies. Because customers change, their communication standards are strict and generalizations are limited, making it challenging to provide practical assistance. Deep reinforcement learning (DRL) enables chatbots to learn the most effective conversational methods through feedback and engagement, potentially revolutionizing the way they interact. DRL-Enhanced Adaptive Dialogue Management Framework (DRL-ADMF) incorporates Dialogue State Tracking (DST), Natural Language Understanding (NLU), and a Deep Q-Network policy learner. The DRL-ADMF employs a reward model that takes into account task performance, user sentiment, resolution efficiency, and conversation length to enhance interaction. A language representation module utilizing pre-trained transformers enhances contextual tracking and semantic comprehension in conversations. DRL-ADMF outperformed classic policy learning models on benchmark datasets and simulated customer service settings. It had shorter reaction times and higher task success rates than its rivals. The suggested DRL-ADMF intelligent and scalable solution for next-generation artificial intelligence chatbots in customer service and virtual assistant applications improves adaptive response generation, conversation coherence, and customization.  © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Popov2019932,
	author = {Popov, Artem and Bulatov, Victor and Polyudova, Darya and Veselova, Eugenia},
	title = {Unsupervised dialogue intent detection via hierarchical topic model},
	year = {2019},
	journal = {International Conference Recent Advances in Natural Language Processing, RANLP},
	volume = {2019-September},
	pages = {932 - 938},
	doi = {10.26615/978-954-452-056-4_108},
	url = {https://www.scopus.com/pages/publications/85076475361?origin=resultslist},
	abstract = {One of the challenges during a task-oriented chatbot development is the scarce availability of the labeled training data. The best way of getting one is to ask the assessors to tag each dialogue according to its intent. Unfortunately, performing labeling without any provisional collection structure is difficult since the very notion of the intent is ill-defined. In this paper, we propose a hierarchical multimodal regularized topic model to obtain a first approximation of the intent set. Our rationale for hierarchical models usage is their ability to take into account several degrees of the dialogues relevancy. We attempt to build a model that can distinguish between subject-based (e.g. medicine and transport topics) and action-based (e.g. filing of an application and tracking application status) similarities. In order to achieve this, we divide set of all features into several groups according to part-of-speech analysis. Various feature groups are treated differently on different hierarchy levels. © 2019 Association for Computational Linguistics (ACL). All rights reserved.},
