	doi = {10.1109/SLAAI-ICAI68534.2025.11318540},
	url = {https://www.scopus.com/pages/publications/105032723071?origin=resultslist},
	abstract = {This article presents a modular AI-driven retail ecommerce chatbot designed to elevate user engagement through advanced natural language understanding (NLU), dynamic dialogue management, and personalized product recommendations. The framework integrates hybrid natural language generation with a context-aware collaborative filtering recommendation engine, supported by fine-tuned transformer models for intent recognition and entity extraction. This combination enables the chatbot to deliver highly relevant, individualized suggestions while maintaining conversational fluidity. In contrast to traditional rule-based or classic machine learning baselines, the proposed system demonstrates measurable improvements in both accuracy and user experience. The adoption of distributed caching mechanisms ensures low-latency responses, allowing the chatbot to scale effectively in high-traffic retail environments. Empirical evaluations show significant gains in query classification accuracy, entity F 1 score, recommendation relevance, and dialogue completion, with users reporting overall higher satisfaction in experiments conducted on the MultiWOZ 2.1 retail subset. Beyond technical performance, the system showcases how intelligent dialogue agents can drive business value by improving product discovery, increasing conversion rates, and fostering stronger customer engagement. Future research should focus on dynamic knowledge integration, improved handling of context-switching, and continual learning to enhance adaptability in evolving retail scenarios. Additionally, challenges such as managing out-of-vocabulary entities, abrupt context shifts, and domain transfer remain critical areas to address for broader deployment.  © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

